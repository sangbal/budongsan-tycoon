# MCP 서버 환경변수 설정 가이드
# 이 파일을 .env.mcp로 복사하고 실제 값을 입력하세요
# .env.mcp는 .gitignore에 추가되어 있으므로 안전하게 토큰을 저장할 수 있습니다
#
# 중요: 값을 입력할 때 따옴표를 사용하지 마세요
# 올바른 형식: BRAVE_API_KEY=BSAxxxxxxxxxx
# 잘못된 형식: BRAVE_API_KEY="BSAxxxxxxxxxx"

# ====================================
# GitHub MCP 서버
# ====================================
# 발급: https://github.com/settings/tokens
# 필요 권한: repo, workflow, read:org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# Supabase PostgreSQL MCP 서버
# ====================================
# 발급: Supabase 프로젝트 대시보드 > Settings > Database > Connection string
# 형식: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ====================================
# Brave Search MCP 서버
# ====================================
# 발급: https://brave.com/search/api/
# 무료 티어: 월 2,000 쿼리
BRAVE_API_KEY=BSA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# TestSprite MCP 서버
# ====================================
# 발급: https://www.testsprite.com/dashboard > Settings > API Keys
# 자동 테스트, 디버깅, 코드 수정 기능
TESTSPRITE_API_KEY=your_testsprite_api_key_here

# ====================================
# 선택적: AWS S3 (에셋 호스팅용)
# ====================================
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-northeast-2

# ====================================
# 선택적: Slack/Discord (배포 알림용)
# ====================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
